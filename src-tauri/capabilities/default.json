{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permessi della finestra principale, delle finestre dei messaggi e della stampa",
  "windows": [
    "main",
    "messaggio-*",
    "stampa-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default"
  ]
}
